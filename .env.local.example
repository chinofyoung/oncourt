# From the Supabase Dashboard → Project Settings → API / Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Session pooler or direct connection string, from Project Settings → Database
DATABASE_URL=
# Comma-separated emails granted the admin role at sign-in
ADMIN_EMAILS=
# PayMongo. Secret key (sk_test_… / sk_live_…) and the per-webhook signing
# secret (whsk_…) from the PayMongo dashboard. Server-only — never
# NEXT_PUBLIC_-prefixed.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Public origin used to build the checkout success/cancel redirect URLs, e.g.
# https://oncourt.ph or http://localhost:3030. Built server-side when the
# checkout session is created, so it follows the server-secret naming
# convention rather than NEXT_PUBLIC_*.
SITE_URL=
# Resend API key (re_…) from the Resend dashboard. Server-only — never
# NEXT_PUBLIC_-prefixed.
RESEND_API_KEY=
# Shared secret the cron scheduler presents as a bearer token to
# /api/cron/drain-email and /api/cron/enqueue-reminders. Any long random
# string; rotate it by changing this and the scheduler together.
CRON_SECRET=
# The From header, e.g. "OnCourt <bookings@oncourt.ph>". The domain must be
# verified in Resend with SPF and DKIM records before real mail will send;
# until then only onboarding@resend.dev works, addressed to the account owner.
EMAIL_FROM=
