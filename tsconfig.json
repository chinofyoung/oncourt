{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // src/db/schema.ts is excluded because it is entirely generated by
  // `drizzle-kit pull` (never hand-edited) and, as of drizzle-kit 0.31.10,
  // its output for the `profiles` table's foreign key to `auth.users` emits
  // `foreignColumns: [users.id]` without ever importing or defining `users`
  // — auth.users lives outside the default `schemaFilter: ['public']`, and
  // widening schemaFilter/tablesFilter to narrow introspection to just
  // `auth.users` was tried and found to be blocked by a real drizzle-kit bug
  // (a `tablesFilter` positive-match entry combined with the negated
  // patterns `extensionsFilters: ['postgis']` injects causes nearly every
  // table name to match again, defeating the narrowing — see
  // task-4-report.md for the full root-cause trace). This exclusion should
  // be revisited the first time a task needs typed queries against
  // `profiles` (or any other table with an `auth.users` FK) via this file.
  "exclude": ["node_modules", "src/db/schema.ts"]
}
